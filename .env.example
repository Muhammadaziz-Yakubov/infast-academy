# =================================================================
# INFAST IT-ACADEMY CRM - ENVIRONMENT CONFIGURATION
# =================================================================
# Copy this file to .env.local or .env for production/development.
# Do NOT commit actual secrets to version control.

# --- Database ---
# MongoDB connection URI (required in production, e.g. mongodb+srv://user:pass@cluster.mongodb.net/infast-crm)
MONGODB_URI=mongodb://127.0.0.1:27017/infast-crm

# --- Security & JWT Authentication ---
# Master secret for signing JWT sessions (MUST be at least 32 characters long)
AUTH_SECRET=change_this_to_a_random_32_character_or_longer_secret_string

# --- Super Admin Credentials ---
ADMIN_LOGIN=admin
ADMIN_PASSWORD=change_this_to_a_strong_password

# --- Telegram Bot & Notifications ---
# Telegram bot API token from @BotFather
TELEGRAM_BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrSTUvwxYZ
# Telegram webhook secret token (verified via X-Telegram-Bot-Api-Secret-Token)
TELEGRAM_WEBHOOK_SECRET=your_telegram_webhook_secret_token
# Target Telegram chat ID for admin alerts and hire requests
TELEGRAM_CHAT_ID=-1001234567890
TELEGRAM_ADMIN_CHAT_ID=-1001234567890

# --- Cron Tasks ---
# Secret token to protect cron routes (verified via x-cron-secret or Authorization: Bearer)
CRON_SECRET=your_cron_schedule_secret_key

# --- SMS Gateway (DevSMS.uz) ---
# API token for sending SMS notifications via devsms.uz
DEVSMS_API_TOKEN=your_devsms_api_token_here

# --- Public URLs ---
# Public website and CRM domain URLs
NEXT_PUBLIC_SITE_URL=https://infast.uz
NEXT_PUBLIC_APP_URL=https://crm.infast.uz

# --- Mobile App (Expo / Student App) ---
EXPO_PUBLIC_API_URL=https://www.infastacademy.uz
EXPO_PUBLIC_USE_LOCALHOST=false

# --- Environment ---
NODE_ENV=development
